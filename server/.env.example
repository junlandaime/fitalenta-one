# --- Server ---
PORT=5000
# development | production (production: cookie secure & Turnstile wajib aktif)
NODE_ENV=development
# Isi 1 jika di belakang reverse proxy (nginx/Cloudflare), kosongkan jika tidak
TRUST_PROXY=

# --- Database ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/fitalenta_db"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=USER
DATABASE_PASSWORD=PASSWORD
DATABASE_NAME=fitalenta_db

# --- JWT ---
# Min. 32 karakter acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_HASIL_GENERATE
JWT_EXPIRES_IN=7d

# --- CORS & URL frontend (tanpa slash di akhir) ---
CORS_ORIGIN=http://localhost:3000
# Untuk link email verifikasi; production isi domain frontend
CLIENT_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=info@domain-anda.com
CONTACT_EMAIL_FROM=Fitalenta Website <noreply@domain-anda.com>
# Pengirim email verifikasi (kosong = pakai CONTACT_EMAIL_FROM)
AUTH_EMAIL_FROM=Fitalenta <noreply@domain-anda.com>
# Catatan: onboarding@resend.dev hanya untuk testing; production pakai domain terverifikasi

# --- Cloudflare Turnstile (secret key) ---
# Dev: 1x0000000000000000000000000000000AA (selalu lolos)
# Production: WAJIB secret asli, jika kosong register/login ditolak (503)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA