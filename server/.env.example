# --- Server ---
PORT=5000
# development | production (production: cookie secure & Turnstile wajib aktif)
NODE_ENV=development
# Isi 1 jika di belakang reverse proxy (nginx/Cloudflare), kosongkan jika tidak
TRUST_PROXY=

# --- Database ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/fitalenta_db"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=USER
DATABASE_PASSWORD=PASSWORD
DATABASE_NAME=fitalenta_db

# --- JWT ---
# Min. 32 karakter acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_HASIL_GENERATE
JWT_EXPIRES_IN=7d

# --- CORS & URL frontend (tanpa slash di akhir) ---
CORS_ORIGIN=http://localhost:3000
# Untuk link email verifikasi; production isi domain frontend (misal https://fitalenta.co.id)
CLIENT_URL=http://localhost:3000

# ==============================================================
# --- Konfigurasi Pengiriman Email (Pilih SMTP atau Resend) ---
# ==============================================================

# OPSI A: Menggunakan Email Hosting / Webmail cPanel (100% Gratis - Rekomendasi Utama)
SMTP_HOST=mail.fitalenta.co.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@fitalenta.co.id
SMTP_PASS=PasswordAkunEmailCpanelAnda
# Jika sertifikat SSL mail server self-signed/bermasalah, set false
SMTP_REJECT_UNAUTHORIZED=false

# OPSI B: Menggunakan Gmail SMTP (Gratis hingga 500 email/hari)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=fitalenta.official@gmail.com
# SMTP_PASS=abcdefghijklmnop # (Wajib App Password 16 karakter dari Google Account)

# Nama & Alamat Pengirim Default
MAIL_FROM="Fitalenta <noreply@fitalenta.co.id>"
AUTH_EMAIL_FROM="Fitalenta <noreply@fitalenta.co.id>"
CONTACT_EMAIL_FROM="Fitalenta <noreply@fitalenta.co.id>"
CONTACT_EMAIL_TO=info@fitalenta.co.id

# OPSI C: Layanan Resend API (Opsional)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudflare Turnstile (secret key) ---
# Dev: 1x0000000000000000000000000000000AA (selalu lolos)
# Production: WAJIB secret asli, jika kosong register/login ditolak (503)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
