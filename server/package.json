{
  "name": "fitalenta-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:admin": "node prisma/seeds/seed-admin.js || tsx prisma/seed-admin.ts",
    "seed:superadmin": "node prisma/seeds/seed-superadmin.js || tsx prisma/seed-superadmin.ts",
    "seed:programs": "node prisma/seeds/seed-programs.js",
    "seed:events-articles": "node prisma/seeds/seed-events-articles.js",
    "seed:testimonials": "node prisma/seeds/seed-testimonials-clients-services.js",
    "seed:team": "node prisma/seeds/seed-team-members.js",
    "seed:gallery": "node prisma/seeds/seed-galleries.js",
    "seed:featured": "node prisma/seeds/seed-featured.js",
    "seed:all": "node prisma/seeds/seed-admin.js && node prisma/seeds/seed-superadmin.js && node prisma/seeds/seed-programs.js && node prisma/seeds/seed-events-articles.js && node prisma/seeds/seed-testimonials-clients-services.js && node prisma/seeds/seed-team-members.js && node prisma/seeds/seed-galleries.js && node prisma/seeds/seed-featured.js",
    "migrate:role": "node prisma/seeds/apply-role-migration.js || tsx prisma/apply-role-migration.ts",
    "migrate:participants": "node prisma/seeds/migrate-participants.js",
    "reset:passwords": "tsx src/scripts/reset-participant-passwords.ts",
    "verify:passwords": "tsx src/scripts/verify-participant-passwords.ts",
    "build:seeds": "esbuild prisma/seed-admin.ts prisma/seed-superadmin.ts prisma/apply-role-migration.ts prisma/seed-programs.ts prisma/seed-events-articles.ts prisma/seed-testimonials-clients-services.ts prisma/seed-team-members.ts prisma/seed-galleries.ts prisma/seed-featured.ts src/scripts/migrate-participants.ts --bundle --platform=node --format=esm --packages=external --outdir=prisma/seeds --entry-names=[name]",
    "seed:testimonials-clients-services": "node prisma/seeds/seed-testimonials-clients-services.js"
  },
  "author": "fitalenta-dev",
  "license": "ISC",
  "description": "",
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "resend": "^6.31.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.25.12",
    "prisma": "^7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
